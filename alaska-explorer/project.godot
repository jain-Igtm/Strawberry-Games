; Alaska Explorer — survival-first prototype.
config_version=5

[application]
config/name="Alaska Explorer"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/energy_saving/keep_screen_on=true

[input]
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87,"unicode":119)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83,"unicode":115)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65,"unicode":97)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68,"unicode":100)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32,"unicode":32)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325), Object(InputEventKey,"physical_keycode":4194326)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69,"unicode":101)]
}
toggle_lamp={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":70,"unicode":102)]
}
attack={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":88,"unicode":120)]
}

[physics]
common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_debanding=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.36, 0.43, 0.51, 1)
