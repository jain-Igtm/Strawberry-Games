func _init() -> void:
	build()

func build(gray: bool = false) -> void:
	ink = GRAY.duplicate() if gray else GREEN.duplicate()
	textures.clear()
	for key in SPRITES:
		var rows: Array = SPRITES[key]
		var im := Image.create(16,16,false,Image.FORMAT_RGBA8)
		im.fill(Color.TRANSPARENT)
		for y in mini(rows.size(),16):
			for x in mini(rows[y].length(),16):
				var ch: String = rows[y][x]
				if ch != '.':
					im.set_pixel(x,y,ink[int(ch)])
		textures[key] = ImageTexture.create_from_image(im)

func sprite(canvas: CanvasItem, key: String, pos: Vector2, flip: bool = false, size: Vector2 = Vector2(16,16)) -> void:
	if not textures.has(key): return
	var rect := Rect2(pos.floor(),size)
	if flip:
		rect.position.x += size.x
		rect.size.x = -size.x
	canvas.draw_texture_rect(textures[key],rect,false)

func text(canvas: CanvasItem, value: String, pos: Vector2, color: int = 3, scale_px: int = 1) -> void:
	var xx := int(pos.x)
	for ch in value.to_upper():
		var glyph: String = FONT.get(ch,FONT[' '])
		for yy in 5:
			for px in 3:
				if glyph[yy*3+px] == '1':
					canvas.draw_rect(Rect2(xx+px*scale_px,int(pos.y)+yy*scale_px,scale_px,scale_px),ink[color])
		xx += 4*scale_px

func centered(canvas: CanvasItem, value: String, y: float, color: int = 3, scale_px: int = 1) -> void:
	text(canvas,value,Vector2((160-value.length()*4*scale_px+scale_px)/2.0,y),color,scale_px)
