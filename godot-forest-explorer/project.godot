; Strawberry Forest Explorer — Godot 4.7 mobile project
; Fresh procedural rebuild. No external art pack is required for the base world.
config_version=5

[application]
config/name="Strawberry Forest Explorer"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=0
window/energy_saving/keep_screen_on=true
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
textures/vram_compression/import_etc2_astc=true
occlusion_culling/use_occlusion_culling=true
environment/defaults/default_clear_color=Color(0.39, 0.55, 0.68, 1)

[input]
move_forward={
"deadzone": 0.18,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_back={
"deadzone": 0.18,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.18,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.18,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
toggle_ui={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":72)]
}

[physics]
3d/default_gravity=18.0
common/physics_ticks_per_second=60
common/physics_interpolation=true
