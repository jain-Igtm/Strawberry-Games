; Strawberry Forest Explorer — Godot 4
; Fresh procedural rebuild. No external assets required for the base world.
config_version=5

[application]
config/name="Strawberry Forest Explorer"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "Mobile")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
occlusion_culling/use_occlusion_culling=true

[input]
move_forward={
"deadzone": 0.18,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_back={
"deadzone": 0.18,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.18,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.18,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
toggle_ui={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":72)]
}

[physics]
3d/default_gravity=18.0
common/physics_ticks_per_second=60

[environment]
defaults/default_clear_color=Color(0.39, 0.55, 0.68, 1)
