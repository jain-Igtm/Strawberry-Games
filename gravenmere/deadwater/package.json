{
  "name": "ashfall-deadwater",
  "private": true,
  "version": "0.18.3",
  "type": "module",
  "scripts": {
    "prepare:audio": "node scripts/fetch-cc0-audio-v7.mjs",
    "prepare:visual-feedback": "node scripts/apply-visual-feedback-v20.mjs",
    "predev": "npm run prepare:audio && npm run prepare:visual-feedback",
    "dev": "vite --host 0.0.0.0",
    "pretest": "npm run prepare:visual-feedback",
    "prebuild": "npm run prepare:audio && npm run prepare:visual-feedback",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "configure:android": "node scripts/configure-android.mjs",
    "sync:android": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/three": "^0.179.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
