{
  "name": "ashfall-raycaster-mobile-spike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/validate-build.mjs",
    "test": "node tests/map.test.mjs && node tests/render-smoke.mjs",
    "serve": "python3 -m http.server 4173 -d www",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:apk": "npm run build && (test -d android || npx cap add android) && npx cap sync android && node scripts/configure-android.mjs && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
